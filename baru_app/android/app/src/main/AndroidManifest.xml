<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- O app fala com o Supabase. Sem isto o release instala e abre, e
         toda chamada de rede morre em "erro de internet" — o `main` e o
         unico manifesto que entra no APK de release, e o template do
         Flutter poe INTERNET so em `debug/` e `profile/`. Por isso
         funcionava no `flutter run` e nao no APK exportado. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Distinguir "sem rede" de "servidor fora" muda a mensagem que a
         pessoa le. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Entrar com a digital/rosto do aparelho. `USE_BIOMETRIC` cobre da
         API 28; `USE_FINGERPRINT` e o nome antigo, para aparelhos mais
         velhos. Nenhuma das duas pede caixa de dialogo: sao normais. -->
    <!-- O vigia da sessao roda com o app em segundo plano; sem isto o
         Flutter simplesmente nao executa e sair do app durante o foco nao
         faz nada. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.USE_FINGERPRINT"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- A sessao de foco termina na hora marcada; um aviso atrasado nao
         serve. Se o usuario negar, o app cai para agendamento inexato. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- O companheiro aparece por cima do app que estourou o tempo. O
         usuario tem de ligar na mao, na tela do sistema: nao ha como
         conceder por codigo. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:label="Baru"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <!-- O icone do app e o bicho da pessoa.
             Um `activity-alias` por especie: o Android so troca o icone da
             gaveta trocando qual componente responde por LAUNCHER, e por
             isso a `MainActivity` deixou de ter o filtro — quem aparece na
             gaveta sao estes. Exatamente um fica ligado por vez. -->
        <activity-alias
            android:name=".IconeCapybara"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Baru">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconeOtter"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_otter"
            android:label="Baru">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconeTortoise"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_tortoise"
            android:label="Baru">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconeOwl"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_owl"
            android:label="Baru">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconeAxolotl"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_axolotl"
            android:label="Baru">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconePenguin"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_penguin"
            android:label="Baru">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconeCat"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_cat"
            android:label="Baru">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconeFox"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_fox"
            android:label="Baru">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- O nome do alias sai de `Species.frenchie` com a inicial em
             maiuscula (`MainActivity.trocaIcone`), e o do mipmap sai do
             `sp.name` cru, minusculo, porque e assim que o `aapt` aceita
             nome de recurso. -->
        <activity-alias
            android:name=".IconeFrenchie"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_frenchie"
            android:label="Baru">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- O Baru na tela inicial.
             `RemoteViews` nao desenha `CustomPainter`, entao o bicho e um
             PNG que o Dart rasteriza e grava; o provider so aponta um
             `ImageView` para o arquivo. -->
        <receiver
            android:name=".BaruWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/baru_widget_info" />
        </receiver>
        <service
            android:name=".OverlayDoBaru"
            android:exported="false" />
        <!-- O vigia da sessao de foco.
             `specialUse` porque nenhum tipo da lista descreve o que ele faz:
             nao e midia, nao e localizacao, nao e chamada. O que ele faz e
             perguntar de dois em dois segundos qual app esta na frente,
             enquanto a sessao corre, e chamar o companheiro de volta — e
             manter na barra a contagem regressiva da pausa em curso, que e
             uma notificacao so, no mesmo id que o lado Dart usa. -->
        <service
            android:name=".VigiaDaSessao"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Manter visivel a contagem regressiva da pausa que a pessoa mesma iniciou e chamar ela de volta ao foco quando sai do app durante essa pausa." />
        </service>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
                    <!-- Deep link do widget da tela inicial.
                 `baru://sequencia`, `baru://tempo`: o `RemoteViews` do
                 launcher nao consegue empurrar estado para o app, entao o
                 destino viaja como endereco. O `BaruRouteParser` le a tela
                 do **host**, porque esquema proprio nao tem barra. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="baru" />
            </intent-filter>
</activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
