<?xml version="1.0" encoding="utf-8"?>
<!-- O widget 2x2 do Baru (pesquisa 26, no padrao dos widgets do Duolingo):
     a cena inteira de fundo - cor do momento, bicho grande saindo pela
     borda -, e por cima o numero da raiz grande com o broto e o chamado
     curto. O texto e TextView de verdade: nitido e lido pelo leitor de tela.
     `RemoteViews` nao aceita ConstraintLayout: FrameLayout e LinearLayout. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/baru_raiz_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/baru_widget_fundo"
    android:clipToOutline="true"
    tools:targetApi="s">

    <ImageView
        android:id="@+id/baru_pet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:id="@+id/baru_raiz_linha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_broto"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/baru_raiz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:fontFamily="sans-serif-black"
                android:textSize="30sp"
                android:textColor="#FFFFFFFF"
                android:includeFontPadding="false"
                android:shadowColor="#55000000"
                android:shadowDy="1.5"
                android:shadowRadius="3" />
        </LinearLayout>

        <TextView
            android:id="@+id/baru_frase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#F2FFFFFF"
            android:shadowColor="#55000000"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
