<?xml version="1.0" encoding="utf-8"?>
<!-- O widget do Baru.
     Layout unico para 2x2 e 4x2: o `ImageView` cresce e o rodape fica.
     `RemoteViews` nao aceita ConstraintLayout, entao e LinearLayout mesmo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/baru_raiz_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/baru_widget_fundo"
    android:padding="8dp">

    <ImageView
        android:id="@+id/baru_pet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp">

        <TextView
            android:id="@+id/baru_nome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FF2E2A26" />

        <TextView
            android:id="@+id/baru_raiz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FF4B7343" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/baru_meta"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:max="100" />
</LinearLayout>
