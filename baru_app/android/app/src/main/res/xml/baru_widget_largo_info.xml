<?xml version="1.0" encoding="utf-8"?>
<!-- O widget retangular: comeca 4x2, com a semana. Aparece na lista do
     Android como um widget proprio, com a sua previa — a pessoa nao precisa
     colocar o quadrado e esticar para descobrir que ele existe. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:maxResizeWidth="420dp"
    android:maxResizeHeight="240dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/baru_widget_largo"
    android:previewImage="@drawable/baru_widget_preview_largo"
    android:description="@string/baru_widget_largo_desc"
    android:widgetCategory="home_screen" />
