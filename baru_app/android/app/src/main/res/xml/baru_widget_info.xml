<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2 no minimo (110x110dp), redimensionavel ate 4x2.
     `updatePeriodMillis="0"`: quem manda atualizar e o app, quando o humor
     muda. O periodico do Android tem minimo de 30 min e gastaria bateria
     redesenhando o que nao mudou. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:maxResizeWidth="300dp"
    android:maxResizeHeight="180dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/baru_widget"
    android:description="@string/baru_widget_desc"
    android:widgetCategory="home_screen" />
