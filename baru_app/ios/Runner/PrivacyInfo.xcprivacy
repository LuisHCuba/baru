		<dict>
			<!-- Preferências do próprio app e do grupo tech.lhcx.baru, que o app
			     divide com as suas extensões (regras do laço, tela compartilhada). -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
